{
  "name": "codecity-extension",
  "displayName": "codecity",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "scripts": {
    "build": "tsc"
  },
  "contributes": {
    "commands": [
      {
        "command": "codecity.ouvrir",
        "title": "codecity : ouvrir le panneau"
      },
      {
        "command": "codecity.arreterMoteur",
        "title": "codecity : arreter le moteur"
      },
      {
        "command": "codecity.ouvrirDansChrome",
        "title": "codecity : ouvrir dans le navigateur"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/vscode": "^1.138.0",
    "typescript": "^7.0.2"
  }
}
